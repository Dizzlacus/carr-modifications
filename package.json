{
  "name": "carr-modifications",
  "version": "1.0.0",
  "description": "Static site for Carr Modifications — a piercing studio.",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:pages": "DEPLOY_TARGET=github-pages astro build",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler dev --config wrangler.jsonc",
    "deploy": "astro build && wrangler deploy --config wrangler.jsonc --no-autoconfig",
    "astro": "astro"
  },
  "license": "ISC",
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.0.9",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
