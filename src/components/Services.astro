---
import { Image } from "astro:assets";
import { services } from "../data/services";
---

<section id="services" class="bg-brand-black w-full max-w-full overflow-hidden pb-[var(--section-space)]">
  <div class="site-container w-full">
    <div class="reveal section-heading">
      <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50 mb-3">02 / Services</p>
      <h2 class="poster-heading text-[clamp(2.75rem,9vw,5.75rem)] mb-4">
        Services
      </h2>
      <p class="text-white/65 max-w-md leading-relaxed text-sm md:text-base">
        Ear, nose, belly, and eyebrow — placement groups for the work.
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {
        services.map((service, index) => (
          <li class:list={["reveal", index === 1 && "reveal-delay-1", index === 2 && "reveal-delay-2", index === 3 && "reveal-delay-3"]}>
            <article class="service-card group relative aspect-[3/4] overflow-hidden border border-white">
              <Image
                src={service.image}
                alt={service.alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="service-card-img absolute inset-0 h-full w-full object-cover"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/10"></div>
              <div class="relative z-[1] flex h-full flex-col items-center justify-end px-5 pb-6 pt-10 text-center">
                <p class="poster-heading text-3xl md:text-4xl">
                  {service.name}
                </p>
                <span class="mt-4 mb-3 block h-px w-10 bg-white" aria-hidden="true"></span>
                <p class="text-xs tracking-wide text-white/70 leading-relaxed">{service.blurb}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
