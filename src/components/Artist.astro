---
import { Image } from "astro:assets";
import { business } from "../data/business";
import artistPortrait from "../assets/artist/portrait.jpg";
---

<section id="artist" class="bg-brand-black w-full max-w-full overflow-hidden pb-[var(--section-space)]">
  <div class="site-container w-full">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center w-full min-w-0">
      <div class="reveal">
        <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50 mb-3">04 / Artist</p>
        <h2 class="poster-heading text-[clamp(2.75rem,9vw,5.75rem)] mb-6">
          The artist
        </h2>
        <p class="text-white/65 leading-relaxed mb-4 text-sm md:text-base">
          {business.artist.bio}
        </p>
        <p class="text-white/65 leading-relaxed text-sm md:text-base">
          Name and socials can land here when they are ready.
        </p>
      </div>
      <div class="reveal reveal-delay-1">
        <figure class="relative aspect-[3/4] md:aspect-[4/5] w-full max-w-[450px] md:ml-auto overflow-hidden border border-white/20 bg-brand-black">
          <Image
            src={artistPortrait}
            alt="Black-and-white profile portrait of the Carr Modifications piercing artist."
            widths={[360, 540, 720, 900]}
            sizes="(min-width: 768px) 450px, 100vw"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
